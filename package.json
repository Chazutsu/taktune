{
  "name": "taktune",
  "version": "0.1.1",
  "private": true,
  "packageManager": "pnpm@10.7.0",
  "engines": { "node": ">=24" },
  "description": "Obsidian-native task, time-block, habit, and review workspace",
  "license": "MIT",
  "repository": "github:Chazutsu/taktune",
  "keywords": [
    "obsidian",
    "task-management",
    "time-blocking"
  ],
  "main": "main.js",
  "scripts": {
    "build": "BUILD=production rolldown -c && tailwindcss -i src/styles.css -o styles.css --minify",
    "build:visual": "rolldown -c rolldown.visual.config.ts && cp node_modules/virtual-obsidian/wasm-pkg/core_bg.wasm tests/visual/dist/core_bg.wasm",
    "check:release": "pnpm build && node scripts/check-taktune-release.mjs",
    "test": "vitest run",
    "test:obsidian-shell": "node tests/obsidian-shell/smoke.mjs",
    "test:visual": "pnpm build && pnpm build:visual && playwright test -c playwright.visual.config.ts",
    "test:visual:update": "pnpm build && pnpm build:visual && playwright test -c playwright.visual.config.ts --update-snapshots",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src/ tests/ --deny-warnings",
    "format": "oxfmt --write src/ tests/",
    "format:check": "oxfmt --check src/ tests/"
  },
  "dependencies": {
    "obsidian-plugin-kit": "https://github.com/Chazutsu/obsidian-plugin-kit/archive/refs/tags/v0.1.0.tar.gz",
    "virtual-obsidian": "https://github.com/Chazutsu/virtual-obsidian/archive/refs/tags/v0.1.0.tar.gz",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/cli": "4.2.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "axe-core": "^4.14.0",
    "builtin-modules": "^5.0.0",
    "jsdom": "28.1.0",
    "obsidian": "^1.12.2",
    "oxfmt": "^0.33.0",
    "oxlint": "^1.48.0",
    "rolldown": "1.0.0-rc.5",
    "tailwindcss": "4.2.0",
    "typescript": "6.0.0-beta",
    "vitest": "4.0.17"
  }
}
